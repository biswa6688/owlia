<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Owlia.Core\Owlia.Core.csproj" />
    <ProjectReference Include="..\Owlia.Data\Owlia.Data.csproj" />
    <ProjectReference Include="..\Owlia.AI\Owlia.AI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="log4net" Version="3.4.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Photino.NET" Version="4.0.16" />
  </ItemGroup>

  <ItemGroup>
    <None Include="log4net.config" CopyToOutputDirectory="PreserveNewest" />
    <!-- Models manifest copied next to exe so ModelManager finds it in dev + published builds -->
    <None Include="..\..\models\models.json"
          CopyToOutputDirectory="PreserveNewest"
          Link="models\models.json" />
    <!-- Brand icon copied next to exe so Photino can load it as the window icon at runtime -->
    <None Include="..\..\assets\owlia.ico"
          CopyToOutputDirectory="PreserveNewest"
          Link="owlia.ico" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\..\assets\owlia.ico</ApplicationIcon>

    <!-- Framework-dependent: installer downloads .NET 10 runtime if absent. -->
    <!-- Keeps published output ~30 MB instead of ~220 MB self-contained.    -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <!-- win-x64 RID required so Photino.Native.dll is resolved correctly -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseAppHost>true</UseAppHost>
  </PropertyGroup>

</Project>
